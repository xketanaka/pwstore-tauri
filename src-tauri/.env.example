# このファイルを .env にコピーして値を入力してください

# Google OAuth 認証情報（Google Cloud Console から取得）
GOOGLE_CLIENT_ID=XXXXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXXXXXXXXXXXXXXXXXX

# Android 用 OAuth クライアント ID（種類：Android）
GOOGLE_CLIENT_ID_ANDROID=XXXXXXXXXX.apps.googleusercontent.com

# passphrase / refresh_token ファイルの難読化キー（任意の文字列）
SECRET_FILE_KEY=your-secret-file-key-here
